{
  "manifest_version": 2,
  "name": "YouTube™ Watched Marker",
  "version": "0.1.34",
  "description": "Queues YouTube™ videos and briefly plays them in a worker window to simulate watched playback.",
  "homepage_url": "https://github.com/selimsum/youtube-watched-marker",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtu.be/*"
  ],
  "background": {
    "scripts": [
      "src/utils/extension.js",
      "src/utils/youtube.js",
      "src/delay.js",
      "src/background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "src/youtube-seed.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "src/utils/extension.js",
        "src/utils/youtube.js",
        "src/delay.js",
        "src/youtube-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "YouTube™ Watched Marker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-watched-marker@hayalet",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "140.0"
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    "src/youtube-seed-hook.js"
  ]
}
